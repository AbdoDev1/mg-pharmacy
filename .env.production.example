# انسخ الملف ده لاسم .env.production واملأ القيم، لا ترفعه أبدًا لأي مكان عام
# ============================================================
#  MG Pharmacy — Fork مستقل عن Biozone
#  DB name/user مختلفين تمامًا عن biozone/biozone عشان العزل يبقى
#  فعلي حتى لو الاتنين شغالين على نفس السيرفر بنفس بوستجريس host.
# ============================================================
SECRET_KEY=غيّر-ده-لمفتاح-عشوائي-طويل-مختلف-عن-Biozone-قبل-أي-استخدام-حقيقي
DEBUG=False

DB_NAME=mgpharmacy
DB_USER=mgpharmacy
DB_PASSWORD=غيّر-ده-باسورد-مختلف-عن-Biozone
DB_HOST=db
DB_PORT=5432
# لازم 0 هنا، مش 60 — pgbouncer.ini شغال بـ pool_mode=transaction (نفس
# إعداد biozone بالضبط، راجع pgbouncer/pgbouncer.ini). transaction pooling
# معناه Django مفروض يقفل الاتصال بعد كل transaction، وCONN_MAX_AGE عالي
# (كان 60 هنا قبل كده) بيخلي كل gunicorn worker يمسك اتصاله لمدة طويلة
# بدل ما يرجّعه للـ pool — يعني بيلغي فايدة الـ pooling نفسها ويقلل عدد
# الاتصالات الفعلية المتاحة لباقي الـ workers. كانت القيمة هنا لسه 60 من
# قبل ما pgbouncer يتضاف لـ mg أصلًا، ومحدش رجع حدّثها بعد كده.
DB_CONN_MAX_AGE=0

# سيبها False للاختبار المحلي (مفيش شهادة SSL حقيقية على localhost).
# لما تنشر على سيرفر حقيقي بدومين وشهادة فعلية، خليها True.
USE_HTTPS_SECURITY=False

# --- الدومين الحقيقي (لما يتحدد) ---
# سيبها فاضية دلوقتي — النظام هيفضل شغال بالإعدادات الافتراضية
# (localhost + *.trycloudflare.com). لما يبقى عندك دومين/hostname خاص
# بـ MG Pharmacy على Cloudflare (لازم يكون مختلف عن hostname Biozone)،
# اكتبه هنا من غير ما تلمس أي كود، وبعدها:
#   docker compose -p mgpharmacy restart web-store web-staff
EXTRA_ALLOWED_HOSTS=
EXTRA_CSRF_TRUSTED_ORIGINS=

# --- Gunicorn / Celery ---
# لازم يكونوا منفصلين بالاسم ده بالظبط (STORE / STAFF) — entrypoint.sh
# بيقرا GUNICORN_WORKERS_<الدور> ديناميكيًا (راجع entrypoint.sh)، مفيش
# قراءة لمتغير عام اسمه GUNICORN_WORKERS خالص، فسيبانها فاضية زي ما كانت
# هنا قبل كده كانت بتتكتب من غير ما تتقرا أبدًا. سيبهم فاضيين دلوقتي —
# entrypoint.sh هيحسب عدد افتراضي تلقائي من عدد الأنوية المتاحة للحاوية
# (2×الأنوية + 1) لو مش متحددين، وده مرتبط مباشرة بالـ cpus: اللي هتتحط
# لكل خدمة في docker-compose.yml (البند الأول في خطة الديون التقنية —
# لسه معمول). لما تتحدد قيم cpus:، رجّع اضبط الأرقام دي يدويًا لو الرقم
# التلقائي مش مناسب.
GUNICORN_WORKERS_STORE=
GUNICORN_WORKERS_STAFF=
# عدد الـ Celery worker processes المتوازية — entrypoint.sh بيرجع لـ 2
# لو سايبها فاضية. كانت مش موجودة في الملف خالص قبل كده رغم إن
# entrypoint.sh بيقراها فعليًا.
CELERY_CONCURRENCY=

# --- Sentry (اختياري تمامًا) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0
